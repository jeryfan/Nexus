#!/usr/bin/env bash
set -euo pipefail

# 命令名 nexus；可执行文件名不硬编码，扫描 Contents/MacOS 取值
# （productName 仍是脚手架名，可能改名）。

function app_realpath() {
	SOURCE=$1
	while [ -h "$SOURCE" ]; do
		DIR=$(dirname "$SOURCE")
		SOURCE=$(readlink "$SOURCE")
		[[ $SOURCE != /* ]] && SOURCE=$DIR/$SOURCE
	done
	SOURCE_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
	echo "${SOURCE_DIR%%${SOURCE_DIR#*.app}}"
}

APP_PATH="$(app_realpath "${BASH_SOURCE[0]}")"
if [ -z "$APP_PATH" ]; then
	echo "Unable to determine Nexus.app path from symlink: ${BASH_SOURCE[0]}" >&2
	exit 1
fi

CONTENTS="$APP_PATH/Contents"
# Why: productName 尚未定稿（现为 nexus-scaffold），不硬编码可执行文件名；
# Electron app 的 Contents/MacOS 下只有主可执行文件，取第一个即可。
ELECTRON=""
for candidate in "$CONTENTS/MacOS"/*; do
	ELECTRON="$candidate"
	break
done
if [ -z "$ELECTRON" ] || [ ! -f "$ELECTRON" ]; then
	echo "Unable to locate the Nexus executable inside $CONTENTS/MacOS" >&2
	exit 1
fi
# Why: Nexus packages the CLI entrypoint outside app.asar so the public shell
# command can execute it directly with ELECTRON_RUN_AS_NODE, mirroring VS Code's
# launcher model instead of requiring a separate npm-distributed binary.
CLI="$CONTENTS/Resources/app.asar.unpacked/out/cli/index.js"

export NEXUS_NODE_OPTIONS="${NODE_OPTIONS-}"
export NEXUS_NODE_REPL_EXTERNAL_MODULE="${NODE_REPL_EXTERNAL_MODULE-}"
unset NODE_OPTIONS
unset NODE_REPL_EXTERNAL_MODULE

ELECTRON_RUN_AS_NODE=1 "$ELECTRON" "$CLI" "$@"
