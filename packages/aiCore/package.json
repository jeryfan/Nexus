{
  "name": "@nexus/ai-core",
  "version": "2.0.1",
  "description": "AI Core - Unified AI Provider Interface Based on Vercel AI SDK",
  "private": true,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "react-native": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsc -w",
    "pretypecheck": "pnpm --filter @nexus/ai-sdk-provider build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --workspace-root exec oxlint packages/aiCore --fix",
    "lint:check": "pnpm --workspace-root exec oxlint packages/aiCore",
    "format": "biome format --write && biome lint --write",
    "format:check": "biome format && biome lint",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "ai",
    "sdk",
    "openai",
    "anthropic",
    "google",
    "vercel-ai-sdk"
  ],
  "author": "Nexus",
  "license": "MIT",
  "peerDependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "ai": "^6.0.116"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/deepseek": "^2.0.30",
    "@ai-sdk/openai-compatible": "^2.0.62",
    "@ai-sdk/provider": "^3.0.14",
    "@ai-sdk/provider-utils": "^4.0.40",
    "@ai-sdk/xai": "^3.0.111",
    "@nexus/ai-sdk-provider": "workspace:*",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "quick-lru": "^5.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^22.19.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "react-native": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./provider": {
      "types": "./dist/provider/index.d.mts",
      "react-native": "./dist/provider/index.mjs",
      "import": "./dist/provider/index.mjs",
      "require": "./dist/provider/index.cjs",
      "default": "./dist/provider/index.mjs"
    }
  }
}
