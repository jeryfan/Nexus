{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@data/*": ["./src/renderer/src/data/*"],
      "@logger": ["./src/renderer/src/services/LoggerService"],
      "@shared/*": ["./src/shared/*"],
      "@nexus/ui/icons": ["./packages/ui/src/components/icons"],
      "@nexus/ui": ["./packages/ui/src"],
      "@nexus/ui/*": ["./packages/ui/src/*"],
      "@nexus/provider-registry/node": [
        "./packages/provider-registry/src/registry-loader"
      ],
      "@nexus/provider-registry": ["./packages/provider-registry/src"]
    }
  },
  "exclude": ["src/**/__tests__/**/*", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
